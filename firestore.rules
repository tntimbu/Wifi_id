rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
        (
          request.auth.token.email == 'admin@wifikota.com' ||
          (
            exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
          )
        );
    }

    // Helper function to check if user is owner of document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Wifi Config - public read so captive portal works for guests
    match /konfigurasi_wifi/{configId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Packages - public read so captive portal works for guests
    match /paket_kuota/{paketId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Transactions
    match /transaksi/{transaksiId} {
      allow read: if request.auth != null && (resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if request.auth != null;
      allow update, delete: if isAdmin() || (request.auth != null && resource.data.user_id == request.auth.uid);
    }

    // Usage logs
    match /pemakaian/{pemakaianId} {
      allow read: if request.auth != null && (resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // Notifications
    match /notifikasi/{notifId} {
      allow read: if request.auth != null && (resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource.data.user_id == request.auth.uid;
      allow delete: if isAdmin() || (request.auth != null && resource.data.user_id == request.auth.uid);
    }

    // Realtime Usage
    match /pemakaian_real_time/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
  }
}
